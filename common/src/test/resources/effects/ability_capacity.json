        "test:capacity_binding"
      ],
      "rules": [
        {
          "id": "resize",
          "on": "test:resize",
          "if": {
            "type": "chorus:source_is",
            "source": "owner"
          },
          "do": [
            {
              "action": {
                "type": "chorus:resize_ability_resource",
                "slot": "chorus_d2:melee",
