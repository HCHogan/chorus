                  "type": "chorus:event_number",
                  "name": "amount",
                  "unit": "charge_fraction"
                }
              },
              "as": "resize"
            },
            {
              "if": {
                "type": "chorus:result_flag",
                "binding": "resize",
                "field": "changed"
              },
              "then": [
                {
                  "type": "chorus:heal",
                  "tags": [
                    "test:capacity_changed"
                  ],
                  "amount": {
                    "type": "chorus:constant",
                    "value": 1,
                    "unit": "damage"
