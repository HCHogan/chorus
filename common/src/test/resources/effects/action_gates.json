      "slot": "test:slot",
      "cost": {
        "resource": "test:gate_energy",
        "amount": {
          "type": "chorus:constant",
          "value": 1,
          "unit": "charge_fraction"
        }
      },
      "tags": [
        "test:super"
      ],
      "parameters": {
        "heal": {
          "value": {
