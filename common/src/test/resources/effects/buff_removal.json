{
  "version":"test-1",
  "buffs":[
    {"definition":{"id":"test:alpha","version":"test-1","duration":2,"max_stacks":5,"instanced_by":"source","on_stow":"pause","tags":["test:active_ability"]},"bundle":"test:alpha_active"},
    {"definition":{"id":"test:beta","version":"test-1","duration":2,"max_stacks":5,"tags":["test:active_ability"]},"bundle":"test:beta_active"},
    {"definition":{"id":"test:unrelated","version":"test-1","duration":2},"bundle":"test:unrelated"}
  ],
  "bundles":[
    {"id":"test:removal","rules":[
      {"id":"activate","on":"test:activate","if":{"type":"chorus:source_is","source":"owner"},"do":[
        {"type":"chorus:grant_buff","buff":"test:alpha","target":"victim","stacks":{"type":"chorus:constant","value":2,"unit":"count"}},
        {"type":"chorus:grant_buff","buff":"test:beta","target":"victim","stacks":{"type":"chorus:constant","value":3,"unit":"count"}},
        {"type":"chorus:grant_buff","buff":"test:unrelated","target":"victim"}
      ]},
      {"id":"alpha","on":"test:alpha","if":{"type":"chorus:source_is","source":"owner"},"do":[
        {"type":"chorus:grant_buff","buff":"test:alpha","target":"victim","stacks":{"type":"chorus:constant","value":2,"unit":"count"}}
      ]},
      {"id":"remove","on":"test:remove","if":{"type":"chorus:source_is","source":"owner"},"do":[
        {"action":{"type":"chorus:remove_buffs_with_tag","tag":"test:active_ability","target":"victim"},"as":"removed"},
        {"if":{"type":"chorus:all","of":[
          {"type":"chorus:result_flag","binding":"removed","field":"changed"},
          {"type":"chorus:compare","op":"ge","left":{"type":"chorus:result","binding":"removed","field":"instances"},"right":{"type":"chorus:constant","value":2,"unit":"count"}},
          {"type":"chorus:compare","op":"ge","left":{"type":"chorus:result","binding":"removed","field":"stacks"},"right":{"type":"chorus:constant","value":5,"unit":"count"}}
        ]},"then":[{"type":"chorus:play_cue","cue":"test:removed_many"}]}
      ]},
      {"id":"batch","on":"chorus:buffs_removed","if":{"type":"chorus:all","of":[
        {"type":"chorus:source_is","source":"owner"},
        {"type":"chorus:event_reference","name":"tag","is":"test:active_ability"}
      ]},"do":[{"type":"chorus:play_cue","cue":"test:batch_observed"}]}
    ]},
    {"id":"test:alpha_active","scope":"buff","rules":[
      {"id":"start","on":"chorus:buff_gained","if":{"type":"chorus:own_buff"},"do":[
        {"after":{"type":"chorus:constant","value":0.2,"unit":"second"},"lifetime":"source","do":[{"type":"chorus:heal","amount":{"type":"chorus:constant","value":7,"unit":"damage"}}]},
        {"after":{"type":"chorus:constant","value":0.2,"unit":"second"},"lifetime":"detached","do":[{"type":"chorus:heal","amount":{"type":"chorus:constant","value":3,"unit":"damage"}}]}
      ]},
      {"id":"ended","on":"chorus:buff_ended","if":{"type":"chorus:all","of":[
        {"type":"chorus:own_buff","reason":"removed"},
        {"type":"chorus:not","of":{"type":"chorus:has_buff_tag","tag":"test:active_ability","target":"self"}}
      ]},"do":[{"type":"chorus:heal","amount":{"type":"chorus:constant","value":1,"unit":"damage"}}]}
    ]},
    {"id":"test:beta_active","scope":"buff","rules":[
      {"id":"ended","on":"chorus:buff_ended","if":{"type":"chorus:all","of":[
        {"type":"chorus:own_buff","reason":"removed"},
        {"type":"chorus:not","of":{"type":"chorus:has_buff_tag","tag":"test:active_ability","target":"self"}}
      ]},"do":[{"type":"chorus:heal","amount":{"type":"chorus:constant","value":2,"unit":"damage"}}]}
    ]},
    {"id":"test:unrelated","scope":"buff"}
  ]
}
