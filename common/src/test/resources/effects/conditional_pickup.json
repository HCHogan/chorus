{
  "version": "test-conditional-pickup-v1",
  "profiles": [
    {
      "id": "test:amount",
      "version": "test-conditional-pickup-v1",
      "input_unit": "damage",
      "steps": []
    },
    {
      "id": "chorus:pickup_attraction_radius",
      "version": "test-conditional-pickup-v1",
      "input_unit": "meter",
      "steps": [
        {
          "type": "chorus:apply",
          "id": "radius",
          "operation": "add",
          "group": {
            "name": "radius",
            "reduction": "sum"
          }
        }
      ]
    }
  ],
  "bundles": [
    {
      "id": "test:pickup",
      "rules": [
        {
          "id": "spawn",
          "on": "test:spawn",
          "do": [
            {
              "action": {
                "type": "chorus:capture_position",
                "target": "self"
              },
              "as": "place"
            },
            {
              "action": {
                "type": "chorus:calculate",
                "profile": "test:amount",
                "input": {
                  "type": "chorus:constant",
                  "value": 7,
                  "unit": "damage"
                }
              },
              "as": "captured"
            },
            {
              "pickup": {
                "position": "place",
                "kind": "test:pickup",
                "recipient": "victim",
                "lifetime": {
                  "type": "chorus:constant",
                  "value": 2,
                  "unit": "second"
                },
                "radius": {
                  "type": "chorus:constant",
                  "value": 0.5,
                  "unit": "meter"
                },
                "attraction": {
                  "profile": "chorus:pickup_attraction_radius",
                  "radius": {
                    "type": "chorus:constant",
                    "value": 0,
                    "unit": "meter"
                  },
                  "speed": {
                    "type": "chorus:constant",
                    "value": 6,
                    "unit": "meter_per_second"
                  }
                }
              },
              "as": "contact",
              "do": [
                {
                  "for_each": "contact",
                  "as": "collector",
                  "do": [
                    {
                      "action": {
                        "type": "chorus:observe_equipped_weapons",
                        "holder": {
                          "binding": "collector"
                        },
                        "tags": [
                          "test:finite"
                        ]
                      },
                      "as": "weapons"
                    },
                    {
                      "for_each": "weapons",
                      "as": "weapon",
                      "do": [
                        {
                          "action": {
                            "type": "chorus:observe_ammo",
                            "weapon": {
                              "binding": "weapon"
                            }
                          },
                          "as": "ammo"
                        },
                        {
                          "if": {
                            "type": "chorus:result_flag",
                            "binding": "ammo",
                            "field": "finite_reserves"
                          },
                          "then": [
                            {
                              "type": "chorus:grant_ammo",
                              "weapon": {
                                "binding": "weapon"
                              },
                              "pool": "reserves",
                              "amount": {
                                "type": "chorus:constant",
                                "value": 3,
                                "unit": "round"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "chorus:heal",
                      "target": {
                        "binding": "collector"
                      },
                      "amount": {
                        "type": "chorus:result",
                        "binding": "captured",
                        "field": "value"
                      }
                    }
                  ]
                },
                {
                  "if": {
                    "type": "chorus:result_flag",
                    "binding": "contact",
                    "field": "expired"
                  },
                  "then": [
                    {
                      "type": "chorus:play_cue",
                      "cue": "test:expired",
                      "target": "self"
                    }
                  ]
                }
              ],
              "collect_if": {
                "type": "chorus:all",
                "of": [
                  {
                    "type": "chorus:compare",
                    "left": {
                      "type": "chorus:equipped_reserve_space",
                      "holder": "victim",
                      "tags": [
                        "test:finite"
                      ]
                    },
                    "op": "gt",
                    "right": {
                      "type": "chorus:constant",
                      "value": 0,
                      "unit": "round"
                    }
                  },
                  {
                    "type": "chorus:compare",
                    "left": {
                      "type": "chorus:result",
                      "binding": "captured",
                      "field": "value"
                    },
                    "op": "eq",
                    "right": {
                      "type": "chorus:constant",
                      "value": 7,
                      "unit": "damage"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "test:collector",
      "rules": [
        {
          "id": "observe",
          "on": "chorus:pickup",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:collected",
              "target": "self"
            }
          ]
        },
        {
          "id": "refill",
          "on": "test:refill",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:refill_magazine",
              "weapon": "event_weapon"
            }
          ]
        }
      ]
    },
    {
      "id": "test:magnet",
      "modifiers": [
        {
          "id": "radius",
          "profile": "chorus:pickup_attraction_radius",
          "stage": "radius",
          "group": "radius",
          "op": "add",
          "stacking_key": "test:magnet",
          "value": {
            "type": "chorus:constant",
            "value": 8,
            "unit": "meter"
          },
          "reference": "Synthetic pickup acceptance radius",
          "confidence": "assumed"
        }
      ]
    }
  ],
  "equipment": {
    "slots": [
      {
        "id": "test:primary",
        "accepts": [
          "test:weapon"
        ],
        "weapon": true
      },
      {
        "id": "test:secondary",
        "accepts": [
          "test:weapon"
        ],
        "weapon": true
      },
      {
        "id": "test:third",
        "accepts": [
          "test:weapon"
        ],
        "weapon": true
      },
      {
        "id": "test:armor",
