        ]
      }
    ],
    "items": [
      {
        "id": "test:finite",
        "tags": [
          "test:weapon",
          "test:finite"
        ]
      },
      {
        "id": "test:infinite",
        "tags": [
          "test:weapon",
          "test:finite"
        ]
      },
      {
        "id": "test:heavy",
        "tags": [
          "test:weapon",
          "test:heavy"
        ]
      },
      {
        "id": "test:unconfigured",
        "tags": [
          "test:weapon",
          "test:finite"
        ]
      },
      {
        "id": "test:armor",
        "tags": [
          "test:armor",
          "test:finite"
        ]
      }
    ]
  },
  "weapons": [
