{
  "version": "compendium-2026-10-05",
  "bundles": [
    {"id": "test:continuity_inputs", "rules": [
      {"id": "apply", "on": "test:apply_sever", "if": {"type": "chorus:source_is", "source": "owner"}, "do": [
        {"action": {"type": "chorus:calculate", "profile": "chorus_d2:strand_debuff_duration", "target": "source_owner",
          "tags": ["chorus_d2:sever"],
          "input": {"type": "chorus:pvp", "pve": {"type": "chorus:constant", "value": 10, "unit": "second"}, "pvp": {"type": "chorus:constant", "value": 5, "unit": "second"}},
          "numbers": {"continuity_extension": {"type": "chorus:pvp", "pve": {"type": "chorus:constant", "value": 5, "unit": "second"}, "pvp": {"type": "chorus:constant", "value": 2.5, "unit": "second"}}}
        }, "as": "duration"},
        {"type": "chorus:apply_status", "buff": "chorus_d2:sever", "duration": {"type": "chorus:result", "binding": "duration", "field": "value"}}
      ]},
      {"id": "later", "on": "test:later", "if": {"type": "chorus:source_is", "source": "owner"}, "do": [
        {"action": {"type": "chorus:calculate", "profile": "chorus_d2:strand_debuff_duration", "target": "source_owner",
          "input": {"type": "chorus:constant", "value": 10, "unit": "second"}, "tags": ["chorus_d2:sever"],
          "numbers": {"continuity_extension": {"type": "chorus:constant", "value": 5, "unit": "second"}}
        }, "as": "captured"},
        {"after": {"type": "chorus:constant", "value": 0.1, "unit": "second"}, "lifetime": "detached", "do": [
          {"type": "chorus:apply_status", "buff": "chorus_d2:sever", "duration": {"type": "chorus:result", "binding": "captured", "field": "value"}}
        ]},
        {"after": {"type": "chorus:constant", "value": 0.2, "unit": "second"}, "lifetime": "detached", "do": [
          {"action": {"type": "chorus:calculate", "profile": "chorus_d2:strand_debuff_duration", "target": "source_owner",
            "input": {"type": "chorus:constant", "value": 10, "unit": "second"}, "tags": ["chorus_d2:sever"],
            "numbers": {"continuity_extension": {"type": "chorus:constant", "value": 5, "unit": "second"}}
          }, "as": "current"},
          {"type": "chorus:apply_status", "buff": "chorus_d2:sever", "duration": {"type": "chorus:result", "binding": "current", "field": "value"}}
        ]}
      ]}
    ]}
  ]
}
