{
  "version": "test-1",
  "profiles": [
    {
      "id": "test:damage",
      "version": "test-1",
      "input_unit": "damage",
      "steps": []
    }
  ],
  "buffs": [
    {
      "definition": {
        "id": "test:counter",
        "version": "test-1",
        "duration": 10,
        "components": {
          "numbers": {
            "instances": {
              "initial": 0,
              "unit": "count"
            },
            "batches": {
              "initial": 0,
              "unit": "count"
            }
          },
          "sets": [
            "seen_damage",
            "seen_batch"
          ]
        }
      }
    }
  ],
  "bundles": [
    {
      "id": "test:actor",
      "rules": [
        {
          "id": "pair",
          "on": "test:pair",
          "do": [
            {
              "action": {
                "type": "chorus:begin_damage_batch"
              },
              "as": "batch"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ],
              "batch": "batch"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ],
              "batch": "batch"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ]
            }
          ]
        },
        {
          "id": "separate",
          "on": "test:separate",
          "do": [
            {
              "action": {
                "type": "chorus:begin_damage_batch"
              },
              "as": "first"
            },
            {
              "action": {
                "type": "chorus:begin_damage_batch"
              },
              "as": "second"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ],
              "batch": "first"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ],
              "batch": "second"
            }
          ]
        },
        {
          "id": "snapshot",
          "on": "test:snapshot",
          "do": [
            {
              "action": {
                "type": "chorus:capture_damage",
                "damage_type": "chorus_gametest:delayed",
                "amount": {
                  "type": "chorus:constant",
                  "value": 2,
                  "unit": "damage"
                },
                "tags": [
                  "test:component"
                ],
                "scaling_profile": "test:damage"
              },
              "as": "attack"
            },
            {
              "action": {
                "type": "chorus:begin_damage_batch"
              },
              "as": "batch"
            },
            {
              "type": "chorus:damage_snapshot",
              "snapshot": "attack",
              "batch": "batch"
            },
            {
              "type": "chorus:damage_snapshot",
              "snapshot": "attack",
              "batch": "batch"
            },
            {
              "type": "chorus:damage_snapshot",
              "snapshot": "attack"
            }
          ]
        },
        {
          "id": "later",
          "on": "test:later",
          "do": [
            {
              "action": {
                "type": "chorus:capture_damage",
                "damage_type": "chorus_gametest:delayed",
                "amount": {
                  "type": "chorus:constant",
                  "value": 2,
                  "unit": "damage"
                },
                "tags": [
                  "test:component"
                ],
                "scaling_profile": "test:damage"
              },
              "as": "attack"
            },
            {
              "action": {
                "type": "chorus:begin_damage_batch"
              },
              "as": "batch"
            },
            {
              "type": "chorus:damage_snapshot",
              "snapshot": "attack",
              "batch": "batch"
            },
            {
              "after": {
                "type": "chorus:constant",
                "value": 0.1,
                "unit": "second"
              },
              "lifetime": "detached",
              "do": [
                {
                  "type": "chorus:damage_snapshot",
                  "snapshot": "attack",
                  "batch": "batch"
                },
                {
                  "type": "chorus:damage_snapshot",
                  "snapshot": "attack"
                }
              ]
            }
          ]
        },
        {
          "id": "area",
          "on": "test:area",
          "do": [
            {
              "action": {
                "type": "chorus:select_targets",
                "radius": {
                  "type": "chorus:constant",
                  "value": 8,
                  "unit": "meter"
                }
              },
              "as": "targets"
            },
            {
              "for_each": "targets",
              "as": "target",
              "do": [
                {
                  "action": {
                    "type": "chorus:begin_damage_batch"
                  },
                  "as": "batch"
                },
                {
                  "type": "chorus:damage",
                  "damage_type": "chorus_gametest:delayed",
                  "amount": {
                    "type": "chorus:constant",
                    "value": 2,
                    "unit": "damage"
                  },
                  "tags": [
                    "test:component"
                  ],
                  "batch": "batch",
                  "target": {
                    "binding": "target"
                  }
                },
                {
                  "type": "chorus:damage",
                  "damage_type": "chorus_gametest:delayed",
                  "amount": {
                    "type": "chorus:constant",
                    "value": 2,
                    "unit": "damage"
                  },
                  "tags": [
                    "test:component"
                  ],
                  "batch": "batch",
                  "target": {
                    "binding": "target"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "cascade",
          "on": "test:cascade",
          "do": [
            {
              "action": {
                "type": "chorus:begin_damage_batch"
              },
              "as": "batch"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:spawn"
              ],
              "batch": "batch"
            },
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ],
              "batch": "batch"
            }
          ]
        },
        {
          "id": "derived",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:event_tag",
            "tag": "test:spawn"
          },
          "do": [
            {
              "type": "chorus:damage",
              "damage_type": "chorus_gametest:delayed",
              "amount": {
                "type": "chorus:constant",
                "value": 2,
                "unit": "damage"
              },
              "tags": [
                "test:component"
              ]
            }
          ]
        },
        {
          "id": "launch",
          "on": "test:launch",
          "do": [
            {
              "action": {
                "type": "chorus:capture_damage",
                "damage_type": "chorus_gametest:delayed",
                "amount": {
                  "type": "chorus:constant",
                  "value": 2,
                  "unit": "damage"
                },
                "tags": [
                  "test:component"
                ],
                "scaling_profile": "test:damage"
              },
              "as": "attack"
            },
            {
              "action": {
                "type": "chorus:capture_position",
                "target": "self",
                "anchor": "eyes"
              },
              "as": "muzzle"
            },
            {
              "action": {
                "type": "chorus:capture_direction",
                "target": "self"
              },
              "as": "aim"
            },
            {
              "projectile": {
                "position": "muzzle",
                "direction": "aim",
                "speed": {
                  "type": "chorus:constant",
                  "value": 20,
                  "unit": "meter_per_second"
                },
                "gravity": {
                  "type": "chorus:constant",
                  "value": 0,
                  "unit": "meter_per_second_squared"
                },
                "drag": {
                  "type": "chorus:constant",
                  "value": 1,
                  "unit": "multiplier"
                },
                "lifetime": {
                  "type": "chorus:constant",
                  "value": 1,
                  "unit": "second"
                }
              },
              "as": "impact",
              "do": [
                {
                  "action": {
                    "type": "chorus:begin_damage_batch"
                  },
                  "as": "batch"
                },
                {
                  "for_each": "impact",
                  "as": "target",
                  "do": [
                    {
                      "type": "chorus:damage_snapshot",
                      "snapshot": "attack",
                      "batch": "batch",
                      "target": {
                        "binding": "target"
                      }
                    },
                    {
                      "type": "chorus:damage_snapshot",
                      "snapshot": "attack",
                      "batch": "batch",
                      "target": {
                        "binding": "target"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "test:observer",
      "rules": [
        {
          "id": "counts",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:source_is",
            "source": "owner"
          },
          "do": [
            {
              "type": "chorus:update_component",
              "buff": "test:counter",
              "component": "instances",
              "op": "add",
              "value": {
                "type": "chorus:constant",
                "value": 1,
                "unit": "count"
              },
              "once_set": "seen_damage",
              "event_reference": "damage_id"
            },
            {
              "type": "chorus:update_component",
              "buff": "test:counter",
              "component": "batches",
              "op": "add",
              "value": {
                "type": "chorus:constant",
                "value": 1,
                "unit": "count"
              },
              "once_set": "seen_batch",
              "event_reference": "batch_id"
            }
          ]
        }
      ]
    }
  ]
}
