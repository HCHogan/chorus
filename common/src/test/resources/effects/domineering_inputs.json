  "bundles": [
    {
      "id": "test:empty"
    },
    {
      "id": "test:reload_observer",
      "rules": [
        {
          "id": "started",
          "on": "chorus:reload_started",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:reload_started"
            }
          ]
        },
        {
          "id": "cancelled",
          "on": "chorus:reload_cancelled",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:reload_cancelled"
            }
          ]
        },
        {
          "id": "finished",
          "on": "chorus:reload_finished",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:heal",
              "amount": {
                "type": "chorus:scale",
                "of": {
                  "type": "chorus:event_number",
                  "name": "applied",
                  "unit": "round"
                },
                "factor": 1,
                "from": "round",
                "to": "damage"
              }
            }
          ]
        },
        {
          "id": "expand",
          "on": "test:expand",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:grant_buff",
              "buff": "test:expanded"
            }
          ]
        },
        {
          "id": "refill",
          "on": "test:refill",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:refill_magazine"
            }
          ]
        },
        {
          "id": "spend",
          "on": "test:spend",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:spend_ammo",
              "amount": {
                "type": "chorus:event_number",
                "name": "rounds",
                "unit": "round"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "test:fast",
      "modifiers": [
        {
          "id": "time",
          "profile": "test:reload_time",
          "stage": "time",
          "group": "time",
          "op": "multiply",
          "stacking_key": "test:fast",
          "value": {
            "type": "chorus:constant",
            "value": -0.5,
            "unit": "delta"
          },
          "reference": "Synthetic reload timing, not Destiny tuning",
          "confidence": "assumed"
        }
      ]
    },
    {
      "id": "test:expanded",
      "scope": "buff",
      "modifiers": [
        {
          "id": "capacity",
          "profile": "test:magazine",
          "stage": "capacity",
          "group": "capacity",
          "op": "multiply",
          "stacking_key": "test:expanded",
          "value": {
            "type": "chorus:constant",
            "value": 1,
            "unit": "delta"
          },
          "reference": "Synthetic reload capacity, not Destiny tuning",
          "confidence": "assumed"
        }
      ]
    },
    {
      "id": "chorus_d2:kill_clip",
      "rules": [
        {
          "id": "window",
          "on": "chorus:kill",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:source_is",
                "source": "this_weapon"
              },
              {
                "type": "chorus:event_tag",
                "tag": "chorus:weapon_kill"
              }
            ]
          },
          "do": [
            {
              "type": "chorus:grant_buff",
              "buff": "chorus_d2:kill_clip_window"
            }
          ]
        },
        {
          "id": "activate",
          "on": "chorus:reload_finished",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:source_is",
                "source": "this_weapon"
              },
              {
                "type": "chorus:has_buff",
                "buff": "chorus_d2:kill_clip_window"
              }
            ]
          },
          "do": [
            {
              "type": "chorus:consume_buff",
              "buff": "chorus_d2:kill_clip_window"
            },
            {
              "type": "chorus:grant_buff",
              "buff": "chorus_d2:kill_clip",
              "duration": {
                "type": "chorus:enhanced",
                "base": {
                  "type": "chorus:constant",
                  "value": 5,
                  "unit": "second"
                },
                "enhanced": {
                  "type": "chorus:constant",
                  "value": 5.5,
                  "unit": "second"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "chorus_d2:kill_clip_active",
      "scope": "buff",
      "modifiers": [
        {
          "id": "damage",
          "profile": "test:weapon_damage",
          "stage": "perks",
          "group": "weapon_perk",
          "op": "multiply",
          "stacking_key": "chorus_d2:kill_clip",
          "value": {
            "type": "chorus:constant",
            "value": 0.25,
            "unit": "delta"
          },
          "if": {
            "type": "chorus:not",
            "of": {
              "type": "chorus:event_tag",
              "tag": "chorus:explosive_perk_damage"
            }
          },
          "reference": "Compendium 2026-10-05 CSV snapshot Weapon Perks C132",
          "confidence": "measured"
        }
      ]
    },
    {
      "id": "test:suppressing_hits",
      "rules": [
        {
          "id": "hit",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "self",
                "right": "event_actor"
              },
              {
                "type": "chorus:event_tag",
                "tag": "chorus:ability_damage"
              }
            ]
          },
          "do": [
            {
              "type": "chorus:invoke_bundle",
              "bundle": "chorus_d2:suppression_application",
              "event": "chorus_d2:apply_suppression",
              "origin": "event",
              "target": "victim",
              "parameters": {
                "combatant_duration": {
                  "type": "chorus:constant",
                  "value": 10,
                  "unit": "second"
                },
                "guardian_duration": {
                  "type": "chorus:constant",
                  "value": 5,
                  "unit": "second"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "test:domineering_inputs",
      "rules": [
        {
          "id": "grant",
          "on": "test:pure_suppression",
          "if": {
            "type": "chorus:source_is",
            "source": "owner"
          },
          "do": [
            {
              "type": "chorus:grant_buff",
              "buff": "chorus_d2:suppression",
              "target": "victim"
            }
          ]
        }
      ]
    }
  ]
