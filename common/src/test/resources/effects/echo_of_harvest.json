        "components": {
          "numbers": {
            "seen": {
              "initial": 0,
              "unit": "count"
            }
          },
          "sets": [
            "death_ids"
          ]
        }
      },
      "bundle": "chorus_d2:harvest_receipts"
    }
  ],
  "bundles": [
    {
      "id": "chorus_d2:echo_of_harvest",
      "parameters": {
        "orb_lifetime": "second",
        "orb_collection_radius": "meter",
        "receipt_seconds": "second"
      },
      "rules": [
        {
          "id": "weakened_kill",
          "on": "chorus:kill",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "self",
                "right": "event_actor"
              },
              {
                "type": "chorus:event_buffs_available",
                "target": "victim"
              },
              {
                "type": "chorus:event_has_buff_tag",
                "target": "victim",
                "tag": "chorus_d2:weaken"
              },
              {
                "type": "chorus:compare",
                "left": {
                  "type": "chorus:source_parameter",
                  "name": "receipt_seconds"
                },
                "op": "gt",
                "right": {
                  "type": "chorus:constant",
                  "value": 0,
                  "unit": "second"
                }
              }
            ]
          },
          "do": [
            {
              "if": {
                "type": "chorus:not",
                "of": {
                  "type": "chorus:has_buff",
                  "buff": "chorus_d2:harvest_receipts"
                }
              },
              "then": [
                {
                  "type": "chorus:grant_buff",
                  "buff": "chorus_d2:harvest_receipts",
                  "duration": {
                    "type": "chorus:source_parameter",
                    "name": "receipt_seconds"
                  }
                }
              ]
            },
            {
              "action": {
                "type": "chorus:update_component",
                "buff": "chorus_d2:harvest_receipts",
                "component": "seen",
                "op": "set",
                "value": {
                  "type": "chorus:constant",
                  "value": 0,
                  "unit": "count"
                },
                "once_set": "death_ids",
                "event_reference": "death_id"
              },
              "as": "receipt"
            },
            {
              "if": {
                "type": "chorus:result_flag",
                "binding": "receipt",
                "field": "applied"
              },
              "then": [
                {
                  "type": "chorus:refresh_buff",
                  "buff": "chorus_d2:harvest_receipts",
                  "duration": {
                    "type": "chorus:source_parameter",
                    "name": "receipt_seconds"
                  }
                },
                {
                  "after": {
                    "type": "chorus:source_parameter",
                    "name": "receipt_seconds"
                  },
                  "lifetime": "detached",
                  "do": [
                    {
                      "type": "chorus:forget_set_entry",
                      "buff": "chorus_d2:harvest_receipts",
                      "component": "death_ids",
                      "event_reference": "death_id"
                    }
                  ]
                },
                {
                  "if": {
                    "type": "chorus:all",
                    "of": [
                      {
                        "type": "chorus:not",
                        "of": {
                          "type": "chorus:has_buff",
                          "buff": "chorus_d2:harvest_cooldown"
                        }
                      },
                      {
                        "type": "chorus:not",
                        "of": {
                          "type": "chorus:has_buff",
                          "buff": "chorus_d2:harvest_pending"
                        }
                      }
                    ]
                  },
                  "then": [
                    {
                      "type": "chorus:grant_buff",
                      "buff": "chorus_d2:harvest_pending"
                    },
                    {
                      "type": "chorus:update_component",
                      "buff": "chorus_d2:harvest_pending",
                      "component": "seen",
                      "op": "set",
                      "value": {
                        "type": "chorus:constant",
                        "value": 0,
                        "unit": "count"
                      },
                      "once_set": "death_ids",
                      "event_reference": "death_id"
                    },
                    {
                      "type": "chorus:invoke_bundle",
                      "bundle": "chorus_d2:harvest_spawn",
                      "event": "chorus_d2:spawn_orb_of_power",
                      "origin": "event",
                      "target": "victim",
                      "parameters": {
                        "super_energy": {
                          "type": "chorus:constant",
                          "value": 0.025,
                          "unit": "charge_fraction"
                        },
                        "lifetime": {
                          "type": "chorus:source_parameter",
                          "name": "orb_lifetime"
                        },
                        "collection_radius": {
                          "type": "chorus:source_parameter",
                          "name": "orb_collection_radius"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "chorus_d2:harvest_spawn",
      "includes": [
        "chorus_d2:orb_of_power_application"
      ],
      "rules": [
