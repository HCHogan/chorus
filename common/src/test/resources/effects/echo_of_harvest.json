            "of": [
              {
                "type": "chorus:own_source"
              },
              {
                "type": "chorus:has_buff",
                "buff": "chorus_d2:harvest_pending"
              },
              {
                "type": "chorus:set_contains_event_reference",
                "buff": "chorus_d2:harvest_pending",
                "component": "death_ids",
                "event_reference": "death_id"
