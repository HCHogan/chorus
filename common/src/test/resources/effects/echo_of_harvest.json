          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:harvest_pending"
            },
            {
              "type": "chorus:invoke_bundle",
              "bundle": "chorus_d2:void_breach_system",
              "event": "chorus_d2:spawn_void_breach",
              "origin": "event",
              "target": "victim",
              "parameters": {}
            }
          ]
        }
      ]
    },
    {
      "id": "chorus_d2:harvest_receipts",
