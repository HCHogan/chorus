              }
            ]
          },
          "do": [
            {
              "type": "chorus:grant_buff",
              "buff": "chorus_d2:harvest_cooldown"
            },
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:harvest_pending"
            },
            {
              "type": "chorus:invoke_bundle",
              "bundle": "chorus_d2:void_breach_system",
              "event": "chorus_d2:spawn_void_breach",
              "origin": "event",
              "target": "victim",
              "parameters": {}
            }
          ]
        },
        {
          "id": "orb_spawn_rejected",
          "on": "chorus_d2:orb_spawn_rejected",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:own_source"
              },
              {
                "type": "chorus:has_buff",
                "buff": "chorus_d2:harvest_pending"
              },
              {
                "type": "chorus:set_contains_event_reference",
                "buff": "chorus_d2:harvest_pending",
                "component": "death_ids",
                "event_reference": "death_id"
              }
            ]
          },
          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:harvest_pending"
            },
            {
              "type": "chorus:invoke_bundle",
              "bundle": "chorus_d2:void_breach_system",
              "event": "chorus_d2:spawn_void_breach",
              "origin": "event",
              "target": "victim",
              "parameters": {}
            }
          ]
        },
        {
