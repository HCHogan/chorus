{
  "version": "compendium-2026-10-05",
  "bundles": [
    {
      "id": "chorus_d2:ember_of_empyrean",
      "rules": [
        {
          "id": "solar_kill",
          "on": "chorus:kill",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "self",
                "right": "event_actor"
              },
              {
                "type": "chorus:event_tag",
                "tag": "chorus:solar_damage"
              },
              {
                "type": "chorus:any",
                "of": [
                  {
                    "type": "chorus:has_buff",
                    "buff": "chorus_d2:radiant",
                    "match": "any"
                  },
                  {
                    "type": "chorus:has_buff",
                    "buff": "chorus_d2:restoration",
                    "match": "any"
                  }
                ]
              }
            ]
          },
          "do": [
            {
              "action": {
                "type": "chorus:inspect_entity",
                "target": "victim"
              },
              "as": "classified"
            },
            {
              "if": {
                "type": "chorus:all",
                "of": [
                  {
                    "type": "chorus:result_flag",
                    "binding": "classified",
                    "field": "available"
                  },
                  {
                    "type": "chorus:any",
                    "of": [
                      {
                        "type": "chorus:result_flag",
                        "binding": "classified",
                        "field": "player"
                      },
                      {
                        "type": "chorus:compare",
                        "op": "eq",
                        "left": {
                          "type": "chorus:arithmetic",
                          "op": "add",
                          "of": [
                            {
                              "type": "chorus:choose",
                              "if": {
                                "type": "chorus:any",
                                "of": [
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "entity",
                                    "tag": "chorus_d2:combatant_tier_1"
                                  },
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "type",
                                    "tag": "chorus_d2:combatant_tier_1"
                                  }
                                ]
                              },
                              "then": {
                                "type": "chorus:constant",
                                "value": 1,
                                "unit": "count"
                              },
                              "else": {
                                "type": "chorus:constant",
                                "value": 0,
                                "unit": "count"
                              }
                            },
                            {
                              "type": "chorus:choose",
                              "if": {
                                "type": "chorus:any",
                                "of": [
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "entity",
                                    "tag": "chorus_d2:combatant_tier_2"
                                  },
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "type",
                                    "tag": "chorus_d2:combatant_tier_2"
                                  }
                                ]
                              },
                              "then": {
                                "type": "chorus:constant",
                                "value": 1,
                                "unit": "count"
                              },
                              "else": {
                                "type": "chorus:constant",
                                "value": 0,
                                "unit": "count"
                              }
                            },
                            {
                              "type": "chorus:choose",
                              "if": {
                                "type": "chorus:any",
                                "of": [
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "entity",
                                    "tag": "chorus_d2:combatant_tier_3"
                                  },
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "type",
                                    "tag": "chorus_d2:combatant_tier_3"
                                  }
                                ]
                              },
                              "then": {
                                "type": "chorus:constant",
                                "value": 1,
                                "unit": "count"
                              },
                              "else": {
                                "type": "chorus:constant",
                                "value": 0,
                                "unit": "count"
                              }
                            },
                            {
                              "type": "chorus:choose",
                              "if": {
                                "type": "chorus:any",
                                "of": [
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "entity",
                                    "tag": "chorus_d2:combatant_tier_4"
                                  },
                                  {
                                    "type": "chorus:observed_entity_tag",
                                    "binding": "classified",
                                    "source": "type",
                                    "tag": "chorus_d2:combatant_tier_4"
                                  }
                                ]
                              },
                              "then": {
                                "type": "chorus:constant",
                                "value": 1,
                                "unit": "count"
                              },
                              "else": {
                                "type": "chorus:constant",
                                "value": 0,
                                "unit": "count"
                              }
                            }
                          ]
                        },
                        "right": {
                          "type": "chorus:constant",
                          "value": 1,
                          "unit": "count"
                        }
                      }
                    ]
                  }
                ]
              },
              "then": [
                {
                  "action": {
                    "type": "chorus:capture_value",
                    "value": {
                      "type": "chorus:choose",
                      "if": {
                        "type": "chorus:result_flag",
                        "binding": "classified",
                        "field": "player"
                      },
                      "then": {
                        "type": "chorus:constant",
                        "value": 3,
                        "unit": "second"
                      },
                      "else": {
                        "type": "chorus:choose",
                        "if": {
                          "type": "chorus:any",
                          "of": [
                            {
                              "type": "chorus:observed_entity_tag",
                              "binding": "classified",
                              "source": "entity",
                              "tag": "chorus_d2:combatant_tier_1"
                            },
                            {
                              "type": "chorus:observed_entity_tag",
                              "binding": "classified",
                              "source": "type",
                              "tag": "chorus_d2:combatant_tier_1"
                            }
                          ]
                        },
                        "then": {
                          "type": "chorus:constant",
                          "value": 1.5,
                          "unit": "second"
                        },
                        "else": {
                          "type": "chorus:choose",
                          "if": {
                            "type": "chorus:any",
                            "of": [
                              {
                                "type": "chorus:observed_entity_tag",
                                "binding": "classified",
                                "source": "entity",
                                "tag": "chorus_d2:combatant_tier_2"
                              },
                              {
                                "type": "chorus:observed_entity_tag",
                                "binding": "classified",
                                "source": "type",
                                "tag": "chorus_d2:combatant_tier_2"
                              }
                            ]
                          },
                          "then": {
                            "type": "chorus:constant",
                            "value": 2.25,
                            "unit": "second"
                          },
                          "else": {
                            "type": "chorus:choose",
                            "if": {
                              "type": "chorus:any",
                              "of": [
                                {
                                  "type": "chorus:observed_entity_tag",
                                  "binding": "classified",
                                  "source": "entity",
                                  "tag": "chorus_d2:combatant_tier_3"
                                },
                                {
                                  "type": "chorus:observed_entity_tag",
                                  "binding": "classified",
                                  "source": "type",
                                  "tag": "chorus_d2:combatant_tier_3"
                                }
                              ]
                            },
                            "then": {
                              "type": "chorus:constant",
                              "value": 3,
                              "unit": "second"
                            },
                            "else": {
                              "type": "chorus:constant",
                              "value": 6,
                              "unit": "second"
                            }
                          }
                        }
                      }
                    }
                  },
                  "as": "extension"
                },
                {
                  "type": "chorus:extend_buff",
                  "buff": "chorus_d2:radiant",
                  "amount": {
                    "type": "chorus:result",
                    "binding": "extension",
                    "field": "value"
                  },
                  "cap": {
                    "type": "chorus:constant",
                    "value": 15,
                    "unit": "second"
                  }
                },
                {
                  "type": "chorus:extend_buff",
                  "buff": "chorus_d2:restoration",
                  "amount": {
                    "type": "chorus:result",
                    "binding": "extension",
                    "field": "value"
                  },
                  "cap": {
                    "type": "chorus:constant",
                    "value": 15,
                    "unit": "second"
                  }
                }
              ],
              "else": [
                {
                  "type": "chorus:emit",
                  "event": "chorus_d2:empyrean_unclassified"
                }
              ]
            }
          ]
        }
      ],
      "modifiers": [
        {
          "id": "health_penalty",
          "profile": "chorus_d2:health_stat",
          "stage": "bonuses",
          "group": "bonuses",
          "op": "add",
          "stacking_key": "chorus_d2:empyrean_health",
          "value": {
            "type": "chorus:constant",
            "value": -10,
            "unit": "stat_point"
          },
          "reference": "Compendium CSV Solar D18/N18; original D21/N21. Stat query only.",
          "confidence": "measured"
        }
      ]
    }
  ]
}
