{
  "version": "test-event-entities",
  "profiles": [
    {
      "id": "test:observed",
      "version": "test-event-entities",
      "input_unit": "count",
      "steps": [
        {
          "type": "chorus:apply",
          "id": "known",
          "operation": "add",
          "group": {
            "name": "known",
            "reduction": "sum"
          }
        }
      ]
    },
    {
      "id": "test:gain",
      "version": "test-event-entities",
      "input_unit": "charge_fraction",
      "steps": [
        {
          "type": "chorus:apply",
          "id": "known",
          "operation": "add",
          "group": {
            "name": "known",
            "reduction": "sum"
          }
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "test:energy",
      "capacity": 1,
      "initial": 0,
      "base_rate": 0,
      "gain_profile": "test:gain"
    }
  ],
  "bundles": [
    {
      "id": "test:driver",
      "modifiers": [
        {
          "id": "observed",
          "profile": "test:observed",
          "stage": "known",
          "group": "known",
          "op": "add",
          "value": {
            "type": "chorus:constant",
            "value": 1,
            "unit": "count"
          },
          "if": {
            "type": "chorus:event_entity_observed"
          },
          "stacking_key": "test:observed",
          "confidence": "measured",
          "reference": "Synthetic receipt observation acceptance"
        },
        {
          "id": "gain",
          "profile": "test:gain",
          "stage": "known",
          "group": "known",
          "op": "add",
          "value": {
            "type": "chorus:constant",
            "value": 0.1,
            "unit": "charge_fraction"
          },
          "if": {
            "type": "chorus:event_entity_observed"
          },
          "stacking_key": "test:gain",
          "confidence": "measured",
          "reference": "Synthetic receipt observation acceptance"
        }
      ],
      "rules": [
        {
          "id": "attack",
          "on": "test:attack",
          "do": [
            {
              "type": "chorus:damage",
              "target": "victim",
              "amount": {
                "type": "chorus:constant",
                "value": 10,
                "unit": "damage"
              },
              "damage_type": "minecraft:generic"
            }
          ]
        },
        {
          "id": "discard",
          "on": "chorus:death",
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:discard"
            }
          ]
        },
        {
          "id": "history",
          "on": "chorus:kill",
          "do": [
            {
              "if": {
                "type": "chorus:event_entity_observed"
              },
              "then": [
                {
                  "action": {
                    "type": "chorus:read_event_entity"
                  },
                  "as": "victim_at_hit"
                },
                {
                  "if": {
                    "type": "chorus:all",
                    "of": [
                      {
                        "type": "chorus:result_flag",
                        "binding": "victim_at_hit",
                        "field": "available"
                      },
                      {
                        "type": "chorus:not",
                        "of": {
                          "type": "chorus:result_flag",
                          "binding": "victim_at_hit",
                          "field": "alive"
                        }
                      },
                      {
                        "type": "chorus:observed_entity_tag",
                        "binding": "victim_at_hit",
                        "tag": "test:tier"
                      }
                    ]
                  },
                  "then": [
                    {
                      "type": "chorus:play_cue",
                      "cue": "test:classified"
                    },
                    {
                      "type": "chorus:emit",
                      "event": "test:copied"
                    },
                    {
                      "after": {
                        "type": "chorus:constant",
                        "value": 0.1,
                        "unit": "second"
                      },
                      "lifetime": "detached",
                      "do": [
                        {
                          "action": {
                            "type": "chorus:read_event_entity"
                          },
                          "as": "later"
                        },
                        {
                          "if": {
                            "type": "chorus:observed_entity_tag",
                            "binding": "later",
                            "tag": "test:tier"
                          },
                          "then": [
                            {
                              "type": "chorus:play_cue",
                              "cue": "test:delayed"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "type": "chorus:play_cue",
                  "cue": "test:unobserved"
                }
              ]
            }
          ]
        },
        {
          "id": "copied",
          "on": "test:copied",
          "if": {
            "type": "chorus:event_entity_observed"
          },
          "do": [
            {
              "action": {
                "type": "chorus:read_event_entity"
              },
              "as": "victim_at_hit"
            },
            {
              "if": {
                "type": "chorus:observed_entity_tag",
                "binding": "victim_at_hit",
                "tag": "test:tier"
              },
              "then": [
                {
                  "type": "chorus:play_cue",
                  "cue": "test:copied"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
