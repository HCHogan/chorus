{
  "version": "test-1",
  "buffs": [
    {
      "definition": {
        "id": "test:finishing",
        "version": "test-1",
        "duration": "permanent",
        "attach": "target",
        "tags": [
          "chorus:finisher_participant"
        ]
      },
      "bundle": "test:finisher_lock"
    },
    {
      "definition": {
        "id": "test:being_finished",
        "version": "test-1",
        "duration": "permanent",
        "attach": "target",
        "tags": [
          "chorus:finisher_participant"
        ]
      },
      "bundle": "test:finisher_lock"
    }
  ],
  "bundles": [
    {
      "id": "test:finisher",
      "rules": [
        {
          "id": "begin",
          "on": "test:begin",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "action": {
                "type": "chorus:begin_finisher",
                "target": "victim",
                "actor_buff": "test:finishing",
                "target_buff": "test:being_finished",
                "duration": {
                  "type": "chorus:constant",
                  "value": 0.3,
                  "unit": "second"
                },
                "policy": {
                  "maximum_health_fraction": 0.2,
                  "range": 3,
                  "eligible_tag": "test:finishable",
                  "line_of_sight": true
                },
                "damage": {
                  "type": "chorus:constant",
                  "value": 1000,
                  "unit": "damage"
                },
                "damage_type": "test:finisher",
                "tags": [
                  "chorus:kinetic"
                ]
              },
              "as": "begun"
            },
            {
              "if": {
                "type": "chorus:result_flag",
                "binding": "begun",
                "field": "busy"
              },
              "then": [
                {
                  "type": "chorus:play_cue",
                  "cue": "test:busy"
                }
              ]
            }
          ]
        },
        {
          "id": "started",
          "on": "chorus:finisher_started",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:started"
            }
          ]
        },
        {
          "id": "completed",
          "on": "chorus:finisher",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:completed"
            }
          ]
        },
        {
          "id": "cancelled",
          "on": "chorus:finisher_cancelled",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:cancelled"
            }
          ]
        },
        {
          "id": "kill",
          "on": "chorus:kill",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:kill"
            }
          ]
        },
        {
          "id": "interrupt",
          "on": "test:interrupt",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "test:finishing"
            }
          ]
        },
        {
          "id": "cancel",
          "on": "test:cancel",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "type": "chorus:cancel_finisher",
              "reason": "test:input_cancelled"
            }
          ]
        }
      ]
    },
    {
      "id": "test:finisher_lock",
      "scope": "buff",
      "action_gates": [
        {
          "id": "ability_use",
          "action": "ability_use"
        },
        {
          "id": "weapon_fire",
          "action": "weapon_fire"
        },
        {
          "id": "weapon_reload",
          "action": "weapon_reload"
        },
        {
          "id": "melee_attack",
          "action": "melee_attack"
        },
        {
          "id": "ranged_attack",
          "action": "ranged_attack"
        },
        {
          "id": "movement_input",
          "action": "movement_input"
        },
        {
          "id": "jump",
          "action": "jump"
        }
      ]
    },
    {
      "id": "test:projectile"
    },
    {
      "id": "test:power"
    }
  ]
}
