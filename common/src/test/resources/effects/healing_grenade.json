                    },
                    "relative_to": "source_owner",
                    "relation": "allied",
                    "include_center": true,
                    "exclude": [
                      "self"
                    ],
                    "order": "identity",
                    "target_anchor": "feet",
                    "line_of_sight": false
                  },
                  "as": "collectors"
                },
