                      {
                        "type": "chorus:result_flag",
                        "binding": "collectors",
                        "field": "available"
                      },
                      {
                        "type": "chorus:compare",
                        "op": "gt",
                        "left": {
                          "type": "chorus:result",
                          "binding": "collectors",
                          "field": "count"
                        },
                        "right": {
                          "type": "chorus:constant",
                          "value": 0,
                          "unit": "count"
                        }
                      }
                    ]
                  },
                  "then": [
                    {
                      "action": {
                        "type": "chorus:capture_value",
                        "value": {
                          "type": "chorus:by_buff_tier",
                          "values": [
                            1,
                            2
                          ],
                          "unit": "count"
                        }
                      },
                      "as": "tier"
                    },
                    {
                      "action": {
                        "type": "chorus:consume_construct",
                        "reference": "current_life"
                      },
                      "as": "claim"
                    },
                    {
                      "if": {
                        "type": "chorus:result_flag",
                        "binding": "claim",
                        "field": "consumed"
                      },
                      "then": [
                        {
                          "type": "chorus:remove_buff",
                          "buff": "chorus_d2:healing_grenade_orb_behavior"
                        },
                        {
                          "for_each": "collectors",
                          "as": "collector",
                          "do": [
                            {
                              "action": {
                                "type": "chorus:calculate",
                                "profile": "chorus_d2:solar_effect_duration",
                                "target": {
                                  "binding": "collector"
                                },
                                "input": {
                                  "type": "chorus:constant",
                                  "value": 4,
                                  "unit": "second"
                                },
                                "tags": [
                                  "chorus_d2:restoration"
                                ]
                              },
                              "as": "duration"
                            },
                            {
                              "type": "chorus:apply_status",
                              "buff": "chorus_d2:restoration",
                              "target": {
                                "binding": "collector"
                              },
                              "tier": {
                                "type": "chorus:result",
                                "binding": "tier",
                                "field": "value"
                              },
                              "duration": {
                                "type": "chorus:result",
                                "binding": "duration",
                                "field": "value"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "type": "chorus:remove_buff",
                  "buff": "chorus_d2:healing_grenade_orb_behavior"
                }
              ]
            }
          ]
        },
