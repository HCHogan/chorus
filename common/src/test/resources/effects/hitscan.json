{
  "version": "hitscan-test-v1",
  "profiles": [
    {
      "id": "test:damage",
      "version": "hitscan-test-v1",
      "input_unit": "damage",
      "steps": []
    }
  ],
  "bundles": [
    {
      "id": "test:projectile",
      "rules": [
        {
          "id": "fire",
          "on": "test:launch",
          "do": [
            {
              "action": {
                "type": "chorus:capture_position",
                "target": "self",
                "anchor": "eyes"
              },
              "as": "muzzle"
            },
            {
              "action": {
                "type": "chorus:capture_direction"
              },
              "as": "aim"
            },
            {
              "action": {
                "type": "chorus:capture_damage",
                "amount": {
                  "type": "chorus:constant",
                  "value": 10,
                  "unit": "damage"
                },
                "damage_type": "minecraft:generic",
                "scaling_profile": "test:damage",
                "tags": [
                  "chorus:weapon_damage"
                ],
                "kill_tags": [
                  "chorus:weapon_kill"
                ]
              },
              "as": "damage"
            },
            {
              "action": {
                "type": "chorus:begin_shot",
                "pellets": {
                  "type": "chorus:constant",
                  "value": 3,
                  "unit": "count"
                },
                "lifetime": {
                  "type": "chorus:constant",
                  "value": 1,
                  "unit": "second"
                }
              },
              "as": "group"
            },
            {
              "hitscan": {
                "position": "muzzle",
                "direction": "aim",
                "range": {
                  "type": "chorus:constant",
                  "value": 20,
                  "unit": "meter"
                }
              },
              "as": "impact",
              "shot": {
                "binding": "group",
                "pellet": {
                  "type": "chorus:constant",
                  "value": 0,
                  "unit": "count"
                }
              },
              "do": [
                {
                  "for_each": "impact",
                  "as": "victim",
                  "do": [
                    {
                      "type": "chorus:damage_snapshot",
                      "snapshot": "damage",
                      "target": {
                        "binding": "victim"
                      },
                      "pellet": "impact"
                    }
                  ]
                }
              ]
            },
            {
              "hitscan": {
                "position": "muzzle",
                "direction": "aim",
                "range": {
                  "type": "chorus:constant",
                  "value": 20,
                  "unit": "meter"
                }
              },
              "as": "impact",
              "shot": {
                "binding": "group",
                "pellet": {
                  "type": "chorus:constant",
                  "value": 1,
                  "unit": "count"
                }
              },
              "do": [
                {
                  "for_each": "impact",
                  "as": "victim",
                  "do": [
                    {
                      "type": "chorus:damage_snapshot",
                      "snapshot": "damage",
                      "target": {
                        "binding": "victim"
                      },
                      "pellet": "impact"
                    }
                  ]
                }
              ]
            },
            {
              "hitscan": {
                "position": "muzzle",
                "direction": "aim",
                "range": {
                  "type": "chorus:constant",
                  "value": 20,
                  "unit": "meter"
                }
              },
              "as": "impact",
              "shot": {
                "binding": "group",
                "pellet": {
                  "type": "chorus:constant",
                  "value": 2,
                  "unit": "count"
                }
              },
              "do": [
                {
                  "for_each": "impact",
                  "as": "victim",
                  "do": [
                    {
                      "type": "chorus:damage_snapshot",
                      "snapshot": "damage",
                      "target": {
                        "binding": "victim"
                      },
                      "pellet": "impact"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "resolved",
          "on": "chorus:shot_resolved",
          "do": [
            {
              "if": {
                "type": "chorus:event_flag",
                "name": "all_hit"
              },
              "then": [
                {
                  "type": "chorus:play_cue",
                  "cue": "test:all_hit"
                }
              ],
              "else": [
                {
                  "type": "chorus:play_cue",
                  "cue": "test:not_all_hit"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "test:power"
    }
  ]
}
