                                              "else": {
                                                "type": "chorus:constant",
                                                "value": 0,
                                                "unit": "count"
                                              }
                                            },
                                            {
                                              "type": "chorus:choose",
                                              "if": {
                                                "type": "chorus:any",
                                                "of": [
                                                  {
                                                    "type": "chorus:observed_entity_tag",
                                                    "binding": "victim",
                                                    "source": "entity",
                                                    "tag": "chorus_d2:boss"
                                                  },
