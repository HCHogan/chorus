                                                    "binding": "victim",
                                                    "source": "type",
                                                    "tag": "chorus_d2:boss"
                                                  }
                                                ]
                                              },
                                              "then": {
                                                "type": "chorus:constant",
                                                "value": 1,
                                                "unit": "count"
                                              },
                                              "else": {
                                                "type": "chorus:constant",
                                                "value": 0,
                                                "unit": "count"
                                              }
                                            },
                                            {
                                              "type": "chorus:choose",
                                              "if": {
                                                "type": "chorus:any",
                                                "of": [
                                                  {
                                                    "type": "chorus:observed_entity_tag",
                                                    "binding": "victim",
                                                    "source": "entity",
                                                    "tag": "chorus_d2:miniboss"
                                                  },
                                                  {
                                                    "type": "chorus:observed_entity_tag",
                                                    "binding": "victim",
