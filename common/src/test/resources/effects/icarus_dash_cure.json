                                                    "tag": "chorus_d2:rank_and_file"
                                                  }
                                                ]
                                              },
                                              "then": {
                                                "type": "chorus:constant",
                                                "value": 1,
                                                "unit": "count"
                                              },
                                              "else": {
                                                "type": "chorus:constant",
                                                "value": 0,
                                                "unit": "count"
                                              }
                                            },
                                            {
                                              "type": "chorus:choose",
                                              "if": {
                                                "type": "chorus:any",
                                                "of": [
                                                  {
                                                    "type": "chorus:observed_entity_tag",
                                                    "binding": "victim",
                                                    "source": "entity",
                                                    "tag": "chorus_d2:elite"
                                                  },
                                                  {
                                                    "type": "chorus:observed_entity_tag",
                                                    "binding": "victim",
                                                    "source": "type",
                                                    "tag": "chorus_d2:elite"
                                                  }
                                                ]
                                              },
                                              "then": {
                                                "type": "chorus:constant",
                                                "value": 1,
                                                "unit": "count"
