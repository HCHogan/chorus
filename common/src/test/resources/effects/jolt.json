                        "type": "chorus:pvp",
                        "pve": {
                          "type": "chorus:constant",
                          "value": 115,
                          "unit": "damage"
                        },
                        "pvp": {
                          "type": "chorus:constant",
                          "value": 45,
                          "unit": "damage"
                        }
