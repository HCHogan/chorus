{
  "version": "test-jolt-v1",
  "buffs": [
    {
      "definition": {
        "id": "chorus_d2:jolt",
        "version": "test-jolt-v1",
        "duration": 10,
        "attach": "target",
        "refresh": "reset",
        "tags": [
          "chorus:arc",
          "chorus:debuff"
        ],
        "components": {
          "numbers": {
            "damage": {
              "initial": 0,
              "unit": "damage"
            },
            "guardian_hits": {
              "initial": 0,
              "unit": "count"
            }
          },
          "sets": [
            "seen_damage"
          ]
        }
      },
      "bundle": "chorus_d2:jolt_active"
    },
    {
      "definition": {
        "id": "chorus_d2:jolt_cooldown",
        "version": "test-jolt-v1",
        "duration": 0.8,
        "attach": "target",
        "refresh": "none"
      }
    }
  ],
  "bundles": [
    {
      "id": "chorus_d2:jolt_application",
      "rules": [
        {
          "id": "apply",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:source_is",
                "source": "owner"
              },
              {
                "type": "chorus:event_tag",
                "tag": "test:apply_jolt"
              }
            ]
          },
          "do": [
            {
              "action": {
                "type": "chorus:apply_status",
                "buff": "chorus_d2:jolt",
                "duration": {
                  "type": "chorus:pvp",
                  "pve": {
                    "type": "chorus:constant",
                    "value": 10,
                    "unit": "second"
                  },
                  "pvp": {
                    "type": "chorus:constant",
                    "value": 5,
                    "unit": "second"
                  }
                }
              },
              "as": "status"
            },
            {
              "if": {
                "type": "chorus:result_flag",
                "binding": "status",
                "field": "applied"
              },
              "then": [
                {
                  "if": {
                    "type": "chorus:all",
                    "of": [
                      {
                        "type": "chorus:event_tag",
                        "tag": "test:jolt_after_damage"
                      },
                      {
                        "type": "chorus:compare",
                        "left": {
                          "type": "chorus:result",
                          "binding": "status",
                          "field": "stacks_before"
                        },
                        "op": "eq",
                        "right": {
                          "type": "chorus:constant",
                          "value": 0,
                          "unit": "count"
                        }
                      }
                    ]
                  },
                  "then": [
                    {
                      "type": "chorus:update_component",
                      "buff": "chorus_d2:jolt",
                      "target": "victim",
                      "component": "damage",
                      "op": "add",
                      "value": {
                        "type": "chorus:constant",
                        "value": 0,
                        "unit": "damage"
                      },
                      "once_set": "seen_damage",
                      "event_reference": "damage_id"
                    }
                  ]
                },
                {
                  "type": "chorus:emit",
                  "event": "chorus_d2:jolt_count"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "chorus_d2:jolt_active",
      "scope": "buff",
      "rules": [
        {
          "id": "hit",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "victim",
                "right": "self"
              },
              {
                "type": "chorus:event_flag",
                "name": "applied"
              }
            ]
          },
          "do": [
            {
              "action": {
                "type": "chorus:update_component",
                "buff": "chorus_d2:jolt",
                "component": "damage",
                "op": "add",
                "value": {
                  "type": "chorus:choose",
                  "if": {
                    "type": "chorus:has_buff",
                    "buff": "chorus_d2:jolt_cooldown"
                  },
                  "then": {
                    "type": "chorus:constant",
                    "value": 0,
                    "unit": "damage"
                  },
                  "else": {
                    "type": "chorus:event_number",
                    "name": "effective_damage",
                    "unit": "damage"
                  }
                },
                "once_set": "seen_damage",
                "event_reference": "damage_id"
              },
              "as": "counted"
            },
            {
              "if": {
                "type": "chorus:all",
                "of": [
                  {
                    "type": "chorus:result_flag",
                    "binding": "counted",
                    "field": "applied"
                  },
                  {
                    "type": "chorus:not",
                    "of": {
                      "type": "chorus:has_buff",
                      "buff": "chorus_d2:jolt_cooldown"
                    }
                  },
                  {
                    "type": "chorus:compare",
                    "op": "ge",
                    "left": {
                      "type": "chorus:result",
                      "binding": "counted",
                      "field": "after"
                    },
                    "right": {
                      "type": "chorus:scale",
                      "factor": 0.1,
                      "from": "damage",
                      "to": "damage",
