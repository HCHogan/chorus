                "type": "chorus:same_entity_life",
                "left": "cast_life",
                "right": "ended_life"
              },
              "then": [
                {
                  "type": "chorus:remove_buff",
                  "buff": "chorus_d2:phoenix_dive_pending"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
