      "bundle": "chorus_d2:proximity_ward_active"
    }
  ],
  "bundles": [
    {
      "id": "chorus_d2:proximity_ward",
      "parameters": {
        "receipt_seconds": "second"
      },
      "rules": [
        {
          "id": "start",
          "on": "chorus:finisher_started",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "event_actor"
          },
          "do": [
            {
              "action": {
                "type": "chorus:observe_finisher",
                "match_event": true
              },
              "as": "phase"
            },
            {
              "if": {
                "type": "chorus:result_flag",
                "binding": "phase",
                "field": "active"
              },
              "then": [
                {
                  "if": {
                    "type": "chorus:not",
                    "of": {
                      "type": "chorus:has_buff",
                      "buff": "chorus_d2:proximity_ward_receipts"
                    }
                  },
                  "then": [
                    {
                      "type": "chorus:grant_buff",
                      "buff": "chorus_d2:proximity_ward_receipts",
                      "duration": {
                        "type": "chorus:arithmetic",
                        "op": "max",
                        "of": [
                          {
                            "type": "chorus:source_parameter",
                            "name": "receipt_seconds"
                          },
                          {
                            "type": "chorus:result",
                            "binding": "phase",
                            "field": "remaining"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "action": {
                    "type": "chorus:update_component",
                    "buff": "chorus_d2:proximity_ward_receipts",
                    "component": "seen",
                    "op": "set",
                    "value": {
                      "type": "chorus:constant",
                      "value": 0,
                      "unit": "count"
                    },
                    "once_set": "finisher_ids",
                    "event_reference": "finisher_id"
                  },
                  "as": "receipt"
                },
                {
                  "if": {
                    "type": "chorus:result_flag",
                    "binding": "receipt",
                    "field": "applied"
                  },
                  "then": [
                    {
                      "type": "chorus:refresh_buff",
                      "buff": "chorus_d2:proximity_ward_receipts",
                      "duration": {
                        "type": "chorus:arithmetic",
                        "op": "max",
                        "of": [
                          {
                            "type": "chorus:source_parameter",
                            "name": "receipt_seconds"
                          },
                          {
                            "type": "chorus:result",
                            "binding": "phase",
                            "field": "remaining"
                          }
                        ]
                      }
                    },
                    {
                      "after": {
                        "type": "chorus:arithmetic",
                        "op": "max",
                        "of": [
                          {
                            "type": "chorus:source_parameter",
                            "name": "receipt_seconds"
                          },
                          {
                            "type": "chorus:result",
                            "binding": "phase",
                            "field": "remaining"
                          }
                        ]
                      },
                      "lifetime": "detached",
                      "do": [
                        {
                          "type": "chorus:forget_set_entry",
                          "buff": "chorus_d2:proximity_ward_receipts",
                          "component": "finisher_ids",
                          "event_reference": "finisher_id"
                        }
                      ]
                    },
                    {
                      "type": "chorus:remove_buff",
                      "buff": "chorus_d2:proximity_ward"
                    },
                    {
                      "type": "chorus:grant_buff",
                      "buff": "chorus_d2:proximity_ward",
                      "duration": {
                        "type": "chorus:result",
                        "binding": "phase",
                        "field": "remaining"
                      }
                    },
                    {
                      "type": "chorus:update_component",
                      "buff": "chorus_d2:proximity_ward",
                      "component": "seen",
                      "op": "set",
                      "value": {
                        "type": "chorus:constant",
                        "value": 0,
                        "unit": "count"
                      },
                      "once_set": "finisher_ids",
                      "event_reference": "finisher_id"
                    },
                    {
                      "type": "chorus:restore_shield",
                      "buff": "chorus_d2:proximity_ward",
                      "amount": {
                        "type": "chorus:constant",
                        "value": 200,
                        "unit": "damage"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "chorus_d2:proximity_ward_active",
      "scope": "buff",
      "rules": [
        {
          "id": "completed",
          "on": "chorus:finisher",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "self",
                "right": "event_actor"
              },
              {
                "type": "chorus:set_contains_event_reference",
                "buff": "chorus_d2:proximity_ward",
                "component": "finisher_ids",
                "event_reference": "finisher_id"
              }
            ]
          },
          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:proximity_ward"
            }
          ]
        },
        {
          "id": "cancelled",
          "on": "chorus:finisher_cancelled",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "self",
                "right": "event_actor"
              },
              {
                "type": "chorus:set_contains_event_reference",
                "buff": "chorus_d2:proximity_ward",
                "component": "finisher_ids",
                "event_reference": "finisher_id"
              }
            ]
          },
          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:proximity_ward"
            }
          ]
        },
        {
          "id": "death",
          "on": "chorus:death",
          "if": {
            "type": "chorus:target_is",
            "left": "self",
            "right": "victim"
          },
          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:proximity_ward"
            }
          ]
        },
        {
          "id": "broken",
          "on": "chorus:shield_broken",
          "if": {
            "type": "chorus:own_shield"
          },
          "do": [
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:proximity_ward"
            }
          ]
        }
      ]
    }
  ]
