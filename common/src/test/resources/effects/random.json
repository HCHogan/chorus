{
  "version": "test-random-v1",
  "bundles": [{"id": "test:random", "rules": [
    {"id": "roll", "on": "test:roll", "do": [
      {"action": {"type": "chorus:sample_random", "distribution": "uniform_real", "lower": {"type": "chorus:constant", "value": 2, "unit": "damage"}, "upper": {"type": "chorus:constant", "value": 8, "unit": "damage"}}, "as": "roll"},
      {"type": "chorus:heal", "amount": {"type": "chorus:result", "binding": "roll", "field": "value"}},
      {"after": {"type": "chorus:constant", "value": 0.1, "unit": "second"}, "lifetime": "detached", "do": [
        {"type": "chorus:heal", "amount": {"type": "chorus:result", "binding": "roll", "field": "value"}}
      ]}
    ]},
    {"id": "audit", "on": "chorus:random_sampled", "do": [
      {"type": "chorus:heal", "amount": {"type": "chorus:event_number", "name": "value", "unit": "damage"}}
    ]},
    {"id": "skip", "on": "test:skip", "if": {"type": "chorus:event_tag", "tag": "test:absent"}, "do": [
      {"type": "chorus:sample_random", "distribution": "uniform_integer", "lower": {"type": "chorus:constant", "value": 1, "unit": "count"}, "upper": {"type": "chorus:constant", "value": 3, "unit": "count"}}
    ]}
  ]}]
}
