  "bundles": [
    {
      "id": "test:yield_cycle",
      "rules": [
        {
          "id": "init",
          "on": "chorus:source_attached",
          "if": {
            "type": "chorus:own_source"
          },
          "do": [
            {
              "type": "chorus:initialize_resource",
              "resource": "test:yield_uses"
            },
            {
              "type": "chorus:initialize_resource",
              "resource": "test:yield_progress"
            }
          ]
        },
        {
          "id": "cycle",
          "on": "chorus:resource_changed",
          "if": {
            "type": "chorus:resource_crossed",
            "resource": "test:yield_progress",
            "threshold": 1,
            "direction": "up"
          },
          "do": [
            {
              "action": {
                "type": "chorus:calculate",
                "profile": "test:cycle_yield",
                "input": {
                  "type": "chorus:constant",
                  "value": 1,
                  "unit": "charge_fraction"
                }
              },
              "as": "yield"
            },
            {
              "action": {
                "type": "chorus:complete_recharge",
                "progress": "test:yield_progress",
                "resource": "test:yield_uses",
                "amount": {
                  "type": "chorus:result",
                  "binding": "yield",
                  "field": "value"
                }
              },
              "as": "cycle"
            },
            {
              "if": {
                "type": "chorus:all",
                "of": [
                  {
                    "type": "chorus:result_flag",
                    "binding": "cycle",
                    "field": "completed"
                  },
                  {
                    "type": "chorus:compare",
                    "left": {
                      "type": "chorus:result",
                      "binding": "cycle",
                      "field": "credited"
                    },
                    "op": "gt",
                    "right": {
                      "type": "chorus:constant",
                      "value": 0,
                      "unit": "charge_fraction"
                    }
                  }
                ]
              },
              "then": [
                {
                  "type": "chorus:heal",
                  "tags": [
                    "test:completed"
                  ],
                  "amount": {
                    "type": "chorus:scale",
                    "of": {
                      "type": "chorus:result",
                      "binding": "cycle",
                      "field": "credited"
                    },
                    "factor": 1,
                    "from": "charge_fraction",
                    "to": "damage"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "start",
          "on": "chorus:resource_spent",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:event_reference",
                "name": "resource",
                "is": "test:yield_uses"
              },
              {
                "type": "chorus:target_is",
                "left": "self",
                "right": "victim"
              },
              {
                "type": "chorus:compare",
                "left": {
                  "type": "chorus:event_number",
                  "name": "before",
                  "unit": "charge_fraction"
                },
                "op": "eq",
                "right": {
                  "type": "chorus:event_number",
                  "name": "capacity",
                  "unit": "charge_fraction"
                }
              }
            ]
          },
          "do": [
            {
              "type": "chorus:spend_resource",
              "resource": "test:yield_progress",
              "amount": {
                "type": "chorus:resource",
                "resource": "test:yield_progress",
                "field": "value"
              },
              "payment": "start_cycle"
            }
          ]
        }
      ],
      "modifiers": [
        {
          "id": "rate",
          "profile": "test:yield_rate",
          "stage": "baseline",
          "group": "base",
          "op": "replace",
          "stacking_key": "test:cycle",
          "value": {
            "type": "chorus:constant",
            "value": 1,
            "unit": "charge_fraction_per_second"
          },
          "if": {
            "type": "chorus:compare",
            "left": {
              "type": "chorus:resource",
              "resource": "test:yield_uses",
              "field": "missing"
            },
            "op": "gt",
            "right": {
              "type": "chorus:constant",
              "value": 0,
              "unit": "charge_fraction"
            }
          },
          "reference": "Synthetic linked cycle calibration; no D2 cooldown claim",
          "confidence": "assumed"
        }
      ]
    },
    {
