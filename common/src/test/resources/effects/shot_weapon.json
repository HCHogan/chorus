    {
      "id": "test:reload_observer",
      "rules": [
        {
          "id": "summary",
          "on": "chorus:shot_resolved",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:shot_resolved"
            },
            {
              "type": "chorus:heal",
              "amount": {
                "type": "chorus:scale",
                "of": {
                  "type": "chorus:event_number",
                  "name": "max_pellets_on_target",
                  "unit": "count"
                },
                "factor": 1,
                "from": "count",
                "to": "damage"
              }
            }
          ]
        },
        {
          "id": "hit",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:pellet_hit"
            }
          ]
        },
        {
          "id": "progress",
          "on": "chorus:shot_progress",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:play_cue",
              "cue": "test:shot_progress"
            }
          ]
        }
      ]
    }
