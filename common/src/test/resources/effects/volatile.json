                      "unit": "meter"
                    }
                  },
                  "as": "nearby"
                },
                {
                  "for_each": "nearby",
                  "as": "target",
                  "do": [
                    {
                      "type": "chorus:damage",
                      "target": {
                        "binding": "target"
                      },
                      "damage_type": "chorus_d2:volatile",
                      "amount": {
                        "type": "chorus:arithmetic",
                        "op": "mul",
                        "of": [
                          {
                            "type": "chorus:scale",
                            "of": {
                              "type": "chorus:pvp",
                              "pve": {
                                "type": "chorus:constant",
                                "value": 145,
                                "unit": "damage"
                              },
                              "pvp": {
                                "type": "chorus:constant",
                                "value": 80,
                                "unit": "damage"
                              }
                            },
                            "factor": 0.1,
                            "from": "damage",
                            "to": "damage"
                          },
                          {
                            "type": "chorus:curve",
                            "of": {
                              "type": "chorus:result",
                              "binding": "target",
                              "field": "distance"
                            },
                            "from": "meter",
                            "to": "multiplier",
                            "curve": {
                              "type": "chorus:table",
                              "points": [
                                {
                                  "input": 0,
                                  "output": 1
                                },
                                {
                                  "input": 5,
                                  "output": 0
                                }
                              ],
                              "interpolation": "linear",
                              "boundary": "clamp"
                            }
                          }
                        ]
                      },
                      "tags": [
                        "chorus:ability_damage",
                        "chorus:void_damage",
                        "chorus_d2:volatile_damage"
                      ],
                      "kill_tags": [
                        "chorus:ability_kill"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "death",
          "on": "chorus:death",
          "if": {
            "type": "chorus:target_is",
            "left": "victim",
            "right": "self"
          },
          "do": [
            {
              "type": "chorus:grant_buff",
              "buff": "chorus_d2:volatile_cooldown",
              "target": "self"
            },
            {
              "type": "chorus:remove_buff",
              "buff": "chorus_d2:volatile",
              "target": "self"
            },
            {
              "action": {
                "type": "chorus:select_targets",
                "center": "self",
                "relative_to": "source_owner",
                "relation": "not_allied",
                "include_center": true,
                "exclude": [
                  "source_owner"
                ],
                "radius": {
                  "type": "chorus:constant",
                  "value": 5,
                  "unit": "meter"
                }
              },
              "as": "nearby"
            },
            {
              "for_each": "nearby",
              "as": "target",
              "do": [
                {
                  "type": "chorus:damage",
                  "target": {
                    "binding": "target"
                  },
                  "damage_type": "chorus_d2:volatile",
                  "amount": {
                    "type": "chorus:arithmetic",
                    "op": "mul",
                    "of": [
                      {
                        "type": "chorus:scale",
                        "of": {
                          "type": "chorus:pvp",
                          "pve": {
                            "type": "chorus:constant",
                            "value": 145,
                            "unit": "damage"
                          },
                          "pvp": {
                            "type": "chorus:constant",
                            "value": 80,
                            "unit": "damage"
                          }
                        },
                        "factor": 0.1,
                        "from": "damage",
                        "to": "damage"
                      },
                      {
                        "type": "chorus:curve",
                        "of": {
                          "type": "chorus:result",
                          "binding": "target",
                          "field": "distance"
                        },
                        "from": "meter",
                        "to": "multiplier",
                        "curve": {
                          "type": "chorus:table",
                          "points": [
                            {
                              "input": 0,
                              "output": 1
                            },
                            {
                              "input": 5,
                              "output": 0
                            }
                          ],
                          "interpolation": "linear",
                          "boundary": "clamp"
                        }
                      }
                    ]
                  },
                  "tags": [
                    "chorus:ability_damage",
                    "chorus:void_damage",
                    "chorus_d2:volatile_damage"
                  ],
                  "kill_tags": [
                    "chorus:ability_kill"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
