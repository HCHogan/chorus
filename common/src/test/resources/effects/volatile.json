{
  "version": "test-volatile-v1",
  "buffs": [
    {
      "definition": {
        "id": "chorus_d2:volatile",
        "version": "test-volatile-v1",
        "duration": 10,
        "attach": "target",
        "refresh": "none",
        "tags": [
          "chorus:void",
          "chorus:debuff"
        ],
        "components": {
          "numbers": {
            "damage": {
              "initial": 0,
              "unit": "damage"
            }
          },
          "sets": [
            "seen_damage"
          ]
        }
      },
      "bundle": "chorus_d2:volatile_active"
    },
    {
      "definition": {
        "id": "chorus_d2:volatile_cooldown",
        "version": "test-volatile-v1",
        "duration": 1,
        "attach": "target",
        "refresh": "none"
      }
    }
  ],
  "bundles": [
    {
      "id": "chorus_d2:volatile_application",
      "rules": [
        {
          "id": "apply",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:source_is",
                "source": "owner"
              },
              {
                "type": "chorus:event_tag",
                "tag": "test:apply_volatile"
              },
              {
                "type": "chorus:not",
                "of": {
                  "type": "chorus:has_buff",
                  "buff": "chorus_d2:volatile",
                  "target": "victim"
                }
              },
              {
                "type": "chorus:not",
                "of": {
                  "type": "chorus:has_buff",
                  "buff": "chorus_d2:volatile_cooldown",
                  "target": "victim"
                }
              }
            ]
          },
          "do": [
            {
              "if": {
                "type": "chorus:event_flag",
                "name": "lethal"
              },
              "then": [
                {
                  "action": {
                    "type": "chorus:check_status",
                    "buff": "chorus_d2:volatile",
                    "target": "victim",
                    "duration": {
                      "type": "chorus:pvp",
                      "pve": {
                        "type": "chorus:constant",
                        "value": 10,
                        "unit": "second"
                      },
                      "pvp": {
                        "type": "chorus:constant",
                        "value": 6,
                        "unit": "second"
                      }
                    },
                    "allow_dead": true
                  },
                  "as": "eligibility"
                },
                {
                  "if": {
                    "type": "chorus:result_flag",
                    "binding": "eligibility",
                    "field": "allowed"
                  },
                  "then": [
                    {
                      "type": "chorus:grant_buff",
                      "buff": "chorus_d2:volatile_cooldown",
                      "target": "victim"
                    },
                    {
                      "type": "chorus:remove_buff",
                      "buff": "chorus_d2:volatile",
                      "target": "victim"
                    },
                    {
                      "action": {
                        "type": "chorus:select_targets",
                        "center": "victim",
                        "relative_to": "source_owner",
                        "relation": "not_allied",
                        "include_center": true,
                        "exclude": [
                          "source_owner"
                        ],
                        "radius": {
                          "type": "chorus:constant",
                          "value": 5,
                          "unit": "meter"
                        }
                      },
                      "as": "nearby"
                    },
                    {
                      "for_each": "nearby",
                      "as": "target",
                      "do": [
                        {
                          "type": "chorus:damage",
                          "target": {
                            "binding": "target"
                          },
                          "damage_type": "chorus_d2:volatile",
                          "amount": {
                            "type": "chorus:arithmetic",
                            "op": "mul",
                            "of": [
                              {
                                "type": "chorus:scale",
                                "of": {
                                  "type": "chorus:pvp",
                                  "pve": {
                                    "type": "chorus:constant",
                                    "value": 145,
                                    "unit": "damage"
                                  },
                                  "pvp": {
                                    "type": "chorus:constant",
                                    "value": 80,
                                    "unit": "damage"
                                  }
                                },
                                "factor": 0.1,
                                "from": "damage",
                                "to": "damage"
                              },
                              {
                                "type": "chorus:curve",
                                "of": {
                                  "type": "chorus:result",
                                  "binding": "target",
                                  "field": "distance"
                                },
                                "from": "meter",
                                "to": "multiplier",
                                "curve": {
                                  "type": "chorus:table",
                                  "points": [
                                    {
                                      "input": 0,
                                      "output": 1
                                    },
                                    {
                                      "input": 5,
                                      "output": 0
                                    }
                                  ],
                                  "interpolation": "linear",
                                  "boundary": "clamp"
                                }
                              }
                            ]
                          },
                          "tags": [
                            "chorus:ability_damage",
                            "chorus:void_damage",
                            "chorus_d2:volatile_damage"
                          ],
                          "kill_tags": [
                            "chorus:ability_kill"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "action": {
                    "type": "chorus:apply_status",
                    "buff": "chorus_d2:volatile",
                    "target": "victim",
                    "duration": {
                      "type": "chorus:pvp",
                      "pve": {
                        "type": "chorus:constant",
                        "value": 10,
                        "unit": "second"
                      },
                      "pvp": {
                        "type": "chorus:constant",
                        "value": 6,
                        "unit": "second"
                      }
                    }
                  },
                  "as": "application"
                },
                {
                  "if": {
                    "type": "chorus:result_flag",
                    "binding": "application",
                    "field": "applied"
                  },
                  "then": [
                    {
                      "type": "chorus:update_component",
                      "buff": "chorus_d2:volatile",
                      "target": "victim",
                      "component": "damage",
                      "op": "add",
                      "value": {
                        "type": "chorus:constant",
                        "value": 0,
                        "unit": "damage"
                      },
                      "once_set": "seen_damage",
                      "event_reference": "damage_id"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "chorus_d2:volatile_active",
      "scope": "buff",
      "rules": [
        {
          "id": "damage",
          "on": "chorus:hit",
          "if": {
            "type": "chorus:all",
            "of": [
              {
                "type": "chorus:target_is",
                "left": "victim",
                "right": "self"
              },
              {
                "type": "chorus:event_flag",
                "name": "applied"
              }
            ]
          },
          "do": [
            {
              "action": {
                "type": "chorus:update_component",
                "buff": "chorus_d2:volatile",
                "component": "damage",
                "op": "add",
                "value": {
                  "type": "chorus:event_number",
                  "name": "effective_damage",
                  "unit": "damage"
                },
                "once_set": "seen_damage",
                "event_reference": "damage_id"
              },
              "as": "accumulated"
            },
            {
              "if": {
                "type": "chorus:any",
                "of": [
                  {
                    "type": "chorus:event_flag",
                    "name": "lethal"
                  },
                  {
                    "type": "chorus:compare",
                    "op": "ge",
                    "left": {
                      "type": "chorus:result",
                      "binding": "accumulated",
                      "field": "after"
                    },
                    "right": {
                      "type": "chorus:scale",
                      "of": {
                        "type": "chorus:pvp",
                        "pve": {
                          "type": "chorus:constant",
                          "value": 190,
                          "unit": "damage"
                        },
                        "pvp": {
                          "type": "chorus:constant",
                          "value": 200,
                          "unit": "damage"
                        }
                      },
                      "factor": 0.1,
