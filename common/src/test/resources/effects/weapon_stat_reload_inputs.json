{
  "version": "compendium-2026-10-05",
  "bundles": [
    {
      "id": "test:weapons_reload_probe",
      "rules": [
        {
          "id": "finished",
          "on": "chorus:reload_finished",
          "if": {
            "type": "chorus:source_is",
            "source": "this_weapon"
          },
          "do": [
            {
              "type": "chorus:heal",
              "amount": {
                "type": "chorus:scale",
                "of": {
                  "type": "chorus:event_number",
                  "name": "applied",
                  "unit": "round"
                },
                "factor": 1,
                "from": "round",
                "to": "damage"
              }
            }
          ]
        }
      ]
    }
  ]
}
