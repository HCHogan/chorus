{
  "14520248": {
    "hash": 14520248,
    "name": "Kinetic Weapon Surge",
    "lastUpload": 1680554889429,
    "type": "Armor Mod General",
    "uploadedBy": "Stardust",
    "descriptions": {
      "en": [
        {
          "linesContent": [
            {
              "text": "Increases Kinetic Weapon damage while you have active Armor Charges:"
            }
          ]
        },
        {
          "classNames": [
            "pve"
          ],
          "linesContent": [
            {
              "text": "• PVE: 10%|17%|22%|25% increased damage with 1|2|3|4 Mods"
            }
          ]
        },
        {
          "classNames": [
            "pvp"
          ],
          "linesContent": [
            {
              "text": "• PVP: 3%|4.5%|5.5%|6% increased damage"
            }
          ]
        },
        {
          "classNames": [
            "spacer"
          ]
        },
        {
          "linesContent": [
            {
              "text": "The 4th tier of the damage buff is only obtainable through Artifact Perks and Exotic Armor."
            }
          ]
        },
        {
          "classNames": [
            "spacer"
          ]
        },
        {
          "linesContent": [
            {
              "text": "Armor Charge now decays over time at the rate of 1 every 10 seconds by default."
            }
          ]
        }
      ]
    }
  },
