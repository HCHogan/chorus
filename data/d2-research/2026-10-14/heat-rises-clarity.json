              "text": "Consuming a "
            },
            {
              "classNames": [
                "solar"
              ]
            },
            {
              "text": "Song of Flame Wisp grants "
            },
            {
              "classNames": [
                "solar"
              ]
            },
            {
              "text": "Cure x3 and "
            },
            {
              "classNames": [
                "solar"
              ]
            },
            {
              "text": "Restoration x2 for 4 seconds."
